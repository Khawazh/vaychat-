# === Infrastructure ===
POSTGRES_USER=vaychat
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vaychat
DATABASE_URL=postgresql://vaychat:change_me_strong_password@localhost:5432/vaychat?schema=public

REDIS_URL=redis://localhost:6379

# === Backend API ===
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# JWT (generate: openssl rand -base64 64)
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OTP (dev: codes logged to console)
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# === Media (Phase 2) ===
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# === Nginx (production) ===
# DOMAIN=vaychat.example.com
